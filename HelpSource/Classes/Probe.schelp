EXAMPLES::

SUBSECTION:: Basic Usage

code::
s.boot;

// 1. Play test audio
x = { Saw.ar([110, 220]) * 0.2 }.play;

// 2. Open instruments via Probe facade or Server *Pb shortcuts
Probe.scope(s, 0, 2);
Probe.spectrum(s, 0);
s.meterPb;
s.scopePb(0, 2);
s.spectralDashboardPb(0);
s.inspectorPb({ |freq=440| RLPF.ar(Saw.ar(freq), 1200, 0.2) });

// 3. Transparent Signal Tracing
y = { SinOsc.ar(440, 0, 0.1).trace(\sineWave) }.play;
y.free;
::

SUBSECTION:: Theming

code::
// because we all love puredata
s.boot;

// 1. Open any instrument directly in Pure Data mode
s.scopePb(theme: \puredata);
s.bandAnalyzerPb(theme: \puredata);
s.meterPb(theme: \puredata);
s.dashboardPb(theme: \puredata);

// 2. Or switch theme dynamically on any running instrument
~scope = s.scopePb;
~scope.theme = \puredata;

// 3. Or set globally as default
ProbeTheme.current = ProbeTheme.get(\puredata);
::
